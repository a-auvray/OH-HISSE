# Modèle du fichier .env : copie-le en `.env` à la racine du dépôt et remplis-le.
# Le vrai .env n'est jamais commité.

# developpement | test | production
OH_HISSE_ENVIRONNEMENT=developpement

# Obligatoire en production. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OH_HISSE_CLE_SECRETE=

# Par défaut : SQLite dans backend/oh-hisse.db. En production, PostgreSQL (l'URL donnée
# par Neon se colle telle quelle, « postgresql:// » est converti pour le pilote psycopg) :
# OH_HISSE_URL_BASE_DE_DONNEES=postgresql://utilisateur:motdepasse@hote/oh_hisse?sslmode=require

# Origines autorisées à appeler l'API (liste JSON). Inutile en production :
# l'interface y est servie par la même origine que l'API.
OH_HISSE_ORIGINES_CORS=["http://localhost:5173"]
