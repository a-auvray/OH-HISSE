# Modèle du fichier .env : copie-le en `.env` à la racine du dépôt et remplis-le.
# Le vrai .env n'est jamais commité.

# developpement | test | production
OH_HISSE_ENVIRONNEMENT=developpement

# Obligatoire en production. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OH_HISSE_CLE_SECRETE=

# Par défaut : SQLite dans backend/oh-hisse.db. En production, PostgreSQL :
# OH_HISSE_URL_BASE_DE_DONNEES=postgresql+psycopg://utilisateur:motdepasse@hote:5432/oh_hisse

# Origines autorisées à appeler l'API (liste JSON)
OH_HISSE_ORIGINES_CORS=["http://localhost:5173"]
